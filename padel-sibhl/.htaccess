# Падел-лига РЕ:КОРТС по адресу sibhl.ru/padel/ — одностраничное приложение React (сборка Vite).
# Отдельно от сайта СХЛ: правила Laravel (index.php) здесь не действуют.
DirectoryIndex index.html
Options -Indexes
AddDefaultCharset utf-8
RewriteEngine On
RewriteBase /padel/
# Только https (sweb за прокси — смотрим X-Forwarded-Proto)
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^ https://sibhl.ru%{REQUEST_URI} [L,R=301]
# старые адреса *.html → новые
RewriteCond %{THE_REQUEST} \s/padel/index\.html[\s?]
RewriteRule ^index\.html$ /padel/ [L,R=301]
RewriteRule ^(zhenskiy|lyubitel|master|profi|40-plus|igroki|raspisanie|rezultaty|foto)\.html$ /padel/$1 [L,R=301]
# всё, что не файл и не папка, — в приложение
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [END]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh|ps1|md|txt)$">
  Require all denied
</FilesMatch>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
